{
  "runtime_checks": [
    {
      "id": "unit-tests",
      "argv": [".venv/bin/python", "-m", "pytest", "tests/", "-q"],
      "timeout_s": 120,
      "paths": [
        "src/**",
        "tests/**",
        "scripts/**",
        "stageforge/**",
        "requirements.txt",
        "vbd.runtime.json"
      ]
    },
    {
      "id": "fixture-path",
      "argv": [".venv/bin/python", "scripts/run_fixture.py", "logs/stage0_fixture"],
      "timeout_s": 60,
      "paths": ["src/**", "scripts/**", "tests/**"]
    },
    {
      "id": "stageforge-sanity",
      "argv": [".venv/bin/python", "stageforge/scripts/sanity_stageforge.py"],
      "timeout_s": 60,
      "paths": ["stageforge/**", "tests/test_stageforge_laws.py"]
    }
  ]
}
